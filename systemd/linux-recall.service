[Unit]
Description=linux_recall: screenshot every minute, skip near-duplicates, OCR the active window
Documentation=https://github.com/junyixu/linux_recall
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# the packaged binary; a uv checkout overrides this with systemd/uv.conf
ExecStart=/usr/bin/linux-recall-daemon --interval 60 --threshold 0.95
Restart=on-failure
RestartSec=30
# OCR runs in the background and resumes after a restart; exit only waits for a running local OCR (~10 s)
TimeoutStopSec=60
Nice=10

[Install]
WantedBy=graphical-session.target
